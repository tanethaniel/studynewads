# Supabase project settings (Project Settings -> API).
# Use the new sb_publishable_/sb_secret_ key format, not the legacy anon/service_role JWTs.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Shared secret for the /api/revalidate endpoint. Generate any random string
# and store the same value in Gumloop's "Call API" node.
REVALIDATE_SECRET=

# Leave the two Supabase vars unset to run the site against the local
# data/seed-ads.json fallback (see lib/ads.ts) with no external services.
