# Supabase project settings (Project Settings -> API).
# Use the new sb_publishable_/sb_secret_ key format, not the legacy anon/service_role JWTs.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Shared secret for the /api/revalidate and /api/backfill-images endpoints.
# Generate any random string and store the same value in Gumloop's
# "Call API" node.
REVALIDATE_SECRET=

# Server-only -- do NOT prefix this with NEXT_PUBLIC_, or it ends up in the
# browser bundle. Only needed for app/api/backfill-images/route.ts.
SUPABASE_SECRET_KEY=sb_secret_...

# Leave the two NEXT_PUBLIC_SUPABASE_* vars unset to run the site against the
# local data/seed-ads.json fallback (see lib/ads.ts) with no external services.
